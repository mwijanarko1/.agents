{
  "$schema": "file:///Users/mikhail/.agents/hooks/schema/agent-hooks.schema.json",
  "version": 1,
  "tasks": {
    "format": { "runner": "script", "name": "format" },
    "lint": { "runner": "script", "name": "lint" },
    "test": { "runner": "command", "argv": ["make", "test"] }
  },
  "protect": {
    "files": [".env*", "secrets/**"],
    "commands": ["terraform destroy"]
  },
  "prGate": { "enabled": true },
  "docs": {
    "paths": ["openapi/**", "schema/**", "docs/**", "src/types/**", "config/**"]
  },
  "schema": {
    "paths": ["db/migrations/**", "prisma/schema.prisma", "supabase/migrations/**", "openapi/**"]
  },
  "tdd": {
    "enabled": true,
    "testCommand": ["npm", "test"],
    "productionPaths": ["src/**", "app/**", "lib/**"],
    "testPaths": ["**/*.test.*", "**/*.spec.*", "tests/**"]
  },
  "learning": {
    "enabled": true,
    "projectScoped": true,
    "captureUserPrompts": true,
    "memoryWrites": "candidate-review"
  },
  "qualityGate": {
    "enabled": true,
    "strict": false
  },
  "web": {
    "enabled": true
  }
}
