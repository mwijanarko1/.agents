{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikhailspeaks.dev/schemas/agent-hooks.schema.json",
  "title": "Agent Hooks Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "$ref": "#/$defs/task" },
        "lint": { "$ref": "#/$defs/task" },
        "test": { "$ref": "#/$defs/task" },
        "doctor": { "$ref": "#/$defs/task" }
      }
    },
    "protect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "prGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tdd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "testCommand": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "productionPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "testPaths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "projectScoped": { "type": "boolean" },
        "captureUserPrompts": { "type": "boolean" },
        "memoryWrites": {
          "type": "string",
          "enum": ["candidate-review", "disabled"]
        }
      }
    },
    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "strict": { "type": "boolean" }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "string",
          "enum": ["script", "command"]
        },
        "name": {
          "type": "string"
        },
        "argv": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "required": ["runner"],
      "allOf": [
        {
          "if": { "properties": { "runner": { "const": "script" } } },
          "then": { "required": ["name"] }
        },
        {
          "if": { "properties": { "runner": { "const": "command" } } },
          "then": { "required": ["argv"] }
        }
      ]
    }
  }
}
