{
  "version": 2,
  "environment": "shared",
  "root": "/Users/mikhail/.agents",
  "docs_required": [
    "AGENTS.md",
    "docs/CODEBASE_MAP.md",
    "docs/DESIGN_CONCEPT.md",
    "docs/GLOSSARY.md"
  ],
  "skills_dir": "skills",
  "skills_root": "/Users/mikhail/.agents/skills",
  "default_stack": {
    "always": [
      "testing-strategies"
    ],
    "skip_when": "task clearly does not need them"
  },
  "skill_triggers": {
    "security-vulnerability-mitigation": {
      "add_when": [
        "auth",
        "input_handling",
        "networking",
        "persistence",
        "secrets",
        "user_data"
      ],
      "condition": "task touches any of these"
    },
    "verification-loop": {
      "add_when": [
        "shared_behavior",
        "cross_module_contracts",
        "pre_release_checks"
      ],
      "condition": "task has medium or higher regression risk"
    },
    "search-first": {
      "add_when": [
        "unknown_codebase",
        "external_api_use",
        "implementation_uncertainty",
        "multi_file_edits",
        "schema_or_data_model_changes",
        "public_api_changes",
        "auth_or_permission_changes",
        "high_assumption_risk"
      ],
      "condition": "discovery materially reduces risk before edits; also when pre-edit investigation reduces risk"
    },
    "t3mp3st": {
      "add_when": [
        "t3mp3st",
        "tempest",
        "authorized_security_testing",
        "red_team_lab",
        "security_recon"
      ],
      "condition": "task asks about T3MP3ST integration/setup or authorized evidence-first security research workflows"
    },
    "testing-strategies": {
      "add_when": [
        "behavior_changes",
        "bug_fixes",
        "runtime_logic_refactors"
      ],
      "condition": "task changes observable behavior"
    },
    "strategic-compact": {
      "add_when": [
        "long_session",
        "phase_boundary",
        "context_pressure",
        "handoff"
      ],
      "condition": "session is long, switching phases, or context needs distillation"
    },
    "effective-agent-skills": {
      "add_when": [
        "skill_authoring",
        "skill_audit",
        "skill_stocktake",
        "skill_not_triggering"
      ],
      "condition": "creating, editing, reviewing, or auditing skills"
    },
    "shipswift-recipes": {
      "add_when": [
        "shipswift",
        "shipswift_recipe",
        "explicit_shipswift_request"
      ],
      "condition": "user explicitly names ShipSwift or recipe catalog/component workflows"
    }
  },
  "task_mapping": {
    "web": {
      "required": [
        "frontend-web-development"
      ],
      "add_when": {
        "backend-architecture": [
          "server_logic",
          "apis"
        ],
        "vercel-react-best-practices": [
          "react_performance",
          "nextjs_performance"
        ],
        "vercel-composition-patterns": [
          "component_apis",
          "reusable_primitives"
        ]
      }
    },
    "mobile": {
      "required": [],
      "file_triggers": [
        "*.swift",
        "*.xcodeproj",
        "*.xcworkspace",
        "Package.swift"
      ],
      "add_when": {
        "ios-development": [
          "swift",
          "swiftui",
          "swift_files",
          "xcode_project",
          "ios_app_code"
        ],
        "swiftui-pro": [
          "swiftui_review",
          "swiftui_correctness"
        ],
        "swiftui-ui-patterns": [
          "swiftui_screens",
          "navigation",
          "layout",
          "state_management"
        ],
        "swiftui-view-refactor": [
          "large_swiftui_views",
          "view_decomposition"
        ],
        "swift-concurrency-pro": [
          "async_await",
          "actors",
          "mainactor",
          "sendable"
        ],
        "swiftdata-pro": [
          "swiftdata",
          "model_persistence"
        ],
        "swift-testing-pro": [
          "swift_tests",
          "xctest",
          "swift_testing_framework"
        ],
        "ios-debugger-agent": [
          "simulator_build_run",
          "runtime_logs",
          "ui_inspection"
        ],
        "ios-app-intents": [
          "app_intents",
          "siri",
          "shortcuts",
          "widgets"
        ],
        "swiftui-performance-audit": [
          "swiftui_performance",
          "slow_rendering",
          "janky_scrolling"
        ],
        "ios-ettrace-performance": [
          "launch_latency",
          "cpu_profiling"
        ],
        "ios-memgraph-leaks": [
          "memory_leaks",
          "retain_cycles",
          "memory_growth"
        ],
        "swiftui-liquid-glass": [
          "liquid_glass",
          "ios26_ui"
        ],
        "ios-app-store-compliance": [
          "app_store_review",
          "submission_readiness"
        ],
        "vercel-react-native-skills": [
          "react_native",
          "expo"
        ],
        "expo-docs": [
          "expo_apis",
          "expo_behavior"
        ]
      },
      "ios_bundle": [
        "ios-development",
        "swiftui-pro",
        "swiftdata-pro",
        "swift-concurrency-pro",
        "swift-testing-pro",
        "ios-app-store-compliance",
        "ios-app-intents",
        "ios-debugger-agent",
        "ios-ettrace-performance",
        "ios-memgraph-leaks",
        "swiftui-liquid-glass",
        "swiftui-performance-audit",
        "swiftui-ui-patterns",
        "swiftui-view-refactor"
      ]
    },
    "review_audit": {
      "add_when": {
        "web-design-guidelines": [
          "ui_review"
        ],
        "website-compliance": [
          "privacy",
          "legal",
          "consumer_protection",
          "accessibility_obligations"
        ],
        "technical-seo": [
          "crawlability",
          "search_performance"
        ]
      }
    },
    "design": {
      "primary_exactly_one": [
        "frontend-design"
      ],
      "primary_triggers": {
        "frontend-design": [
          "net_new_interface",
          "greenfield_ui",
          "improve_existing_ui",
          "upgrade_interface",
          "visual_design",
          "ui_polish",
          "landing_page",
          "typography",
          "color_palette",
          "layout_design",
          "motion_design",
          "redesign"
        ]
      },
      "file_triggers": [
        "components/**/*.tsx",
        "components/**/*.jsx",
        "app/**/*.tsx",
        "pages/**/*.tsx",
        "*.css",
        "*.scss"
      ],
      "secondary": {
        "design-md-gallery": {
          "only_after": [
            "frontend-design"
          ],
          "never_alone": true
        },
        "design-systems-reference": {
          "only_after": [
            "frontend-design"
          ],
          "never_alone": true
        }
      }
    }
  },
  "conflict_resolution": [
    {
      "priority": 1,
      "rule": "prefer_more_specific_over_general"
    },
    {
      "priority": 2,
      "rule": "prefer_implementation_for_building_audit_for_review_finish_for_polish"
    },
    {
      "priority": 3,
      "rule": "overlap_keep_narrower_trigger_use_broader_for_gaps"
    },
    {
      "priority": 4,
      "rule": "visual_design_never_overrides",
      "overrides_forbidden": [
        "accessibility",
        "security",
        "functional_correctness"
      ]
    }
  ],
  "codebase_awareness": {
    "check_paths": [
      "docs/CODEBASE_MAP.md",
      "CODEBASE_MAP.md"
    ],
    "if_missing": {
      "action": "use_cartographer",
      "create_before": "substantial_changes"
    },
    "if_present": {
      "action": "review_before_editing"
    }
  },
  "collaboration_practices": {
    "shared_design_concept": {
      "default": "required_before_non_trivial_implementation",
      "applies_to": [
        "substantial_feature_work",
        "broad_refactors",
        "cross_module_changes",
        "ambiguous_requests",
        "new_public_interfaces",
        "data_model_or_api_changes"
      ],
      "may_skip_for": [
        "tiny_single_file_edits",
        "documentation_only_changes",
        "mechanical_formatting",
        "obvious_low_risk_fixes"
      ],
      "must_cover": [
        "goal",
        "affected_modules",
        "contracts_and_invariants",
        "non_goals",
        "verification_loop"
      ],
      "if_unclear": "ask_focused_questions_or_state_smallest_reasonable_assumptions",
      "preserve_when_useful": [
        "final_response",
        "issue",
        "prd",
        "adr",
        "project_docs"
      ]
    },
    "ubiquitous_language": {
      "default": "maintain_project_glossary",
      "preferred_path": "docs/GLOSSARY.md",
      "create_when_missing_for": [
        "substantial_domain_work",
        "new_domain_concepts",
        "new_workflow_states",
        "new_module_boundaries",
        "new_roles_or_permissions",
        "public_api_or_event_names"
      ],
      "reuse_terms_in": [
        "prompts",
        "code_identifiers",
        "tests",
        "docs",
        "issues",
        "pull_requests"
      ],
      "conflict_resolution": "prefer_terms_used_at_stable_module_boundaries_and_note_inconsistencies_before_editing"
    },
    "feedback_loops": {
      "default": "verify_in_small_increments",
      "required_for_behavior_changes": [
        "tdd_red_green_evidence",
        "closest_fast_test",
        "final_relevant_test_target"
      ],
      "linted_projects": "run_relevant_lint_command_before_final_response_after_code_changes_and_do_not_knowingly_leave_lint_errors",
      "typed_projects": "run_relevant_type_check_before_final_response_when_practical",
      "frontend_changes": "use_browser_or_playwright_when_layout_interaction_routing_forms_rendering_or_accessibility_are_affected",
      "shared_contracts": "test_at_module_or_api_boundary",
      "avoid": "large_unverified_diffs"
    }
  },
  "ai_flow": {
    "enabled": true,
    "default_mode": "unset",
    "mode_selection": "prompt_command_required",
    "state_file": ".git/agent-notes/ai-flow-state.json",
    "commands": {
      "serious": "/serious",
      "fun": "/fun"
    },
    "modes": {
      "serious": {
        "requires_interview_before_mutation": true,
        "requires_brief": true,
        "requires_tdd_for_behavior_changes": true,
        "requires_verification_report": true
      },
      "fun": {
        "requires_interview_before_mutation": false,
        "requires_brief": false,
        "requires_tdd_for_behavior_changes": false,
        "safety_gates_enabled": true
      }
    },
    "required_brief_fields": [
      "goal",
      "success_criteria",
      "current_state",
      "affected_modules",
      "contracts_and_invariants",
      "ubiquitous_language",
      "risks_and_edge_cases",
      "verification_loop",
      "out_of_scope"
    ]
  },
  "core_principles": [
    {
      "id": "test_driven_programming",
      "rule": "write_or_update_a_failing_behavior_test_before_production_changes_when_changing_behavior_or_fixing_defects"
    },
    {
      "id": "shared_design_concept",
      "rule": "align_on_goal_affected_modules_contracts_non_goals_and_verification_before_non_trivial_implementation"
    },
    {
      "id": "ubiquitous_language",
      "rule": "maintain_and_reuse_project_domain_terms_through_docs_code_tests_prompts_and_prs"
    },
    {
      "id": "feedback_loops",
      "rule": "run_small_incremental_tests_type_checks_lint_checks_browser_checks_or_manual_checks_close_to_the_change"
    },
    {
      "id": "no_lint_errors",
      "rule": "run_project_lint_when_available_after_code_changes_and_do_not_finish_with_known_lint_errors"
    },
    {
      "id": "simplicity_first",
      "rule": "smallest_change_that_fully_solves"
    },
    {
      "id": "no_laziness",
      "rule": "find_root_causes_no_papering_over"
    },
    {
      "id": "minimal_impact",
      "rule": "touch_only_what_materially_needs_change"
    },
    {
      "id": "surface_assumptions",
      "rule": "state_material_assumptions_before_acting_and_ask_when_ambiguity_changes_the_solution"
    },
    {
      "id": "no_speculative_abstractions",
      "rule": "do_not_add_unrequested_abstractions_configurability_features_or_impossible_error_handling"
    },
    {
      "id": "surgical_changes",
      "rule": "preserve_adjacent_code_comments_formatting_and_style_unless_directly_required_by_the_task"
    },
    {
      "id": "changed_lines_trace_to_request",
      "rule": "every_changed_line_should_trace_to_the_user_request_or_to_cleanup_created_by_this_change"
    }
  ],
  "test_driven_programming": {
    "default": "test_first_for_behavior_changes_and_defect_fixes",
    "workflow": [
      "define_observable_behavior_and_edge_cases",
      "write_or_update_the_narrowest_meaningful_failing_test",
      "make_the_smallest_production_change_to_pass",
      "run_the_relevant_test_target",
      "report_tests_run_or_explain_why_not_run"
    ],
    "exceptions": [
      "documentation_only_changes",
      "mechanical_formatting_or_renames_with_no_behavior_change",
      "test_first_impractical_because_no_runnable_harness_or_external_constraint"
    ],
    "exception_requirement": "state_the_reason_and_use_the_smallest_alternative_verification",
    "quality_bar": "test_user_visible_behavior_and_regression_risk_not_implementation_details"
  },
  "domain_subagents": {
    "thermo_review": {
      "optional": [
        "thermo-nuclear-review-subagent",
        "thermo-nuclear-code-quality-review-subagent"
      ],
      "routing": {
        "agents": [
          "thermo-nuclear-review-subagent",
          "thermo-nuclear-code-quality-review-subagent"
        ],
        "mode": "parallel_then_synthesize",
        "scope": "diff_only",
        "default_base": "main"
      }
    }
  },
  "mandatory_tdd": {
    "enabled": true,
    "applies_to": [
      "behavior_changes",
      "bug_fixes",
      "refactors_touching_runtime_logic"
    ],
    "evidence_file": ".git/agent-notes/tdd-evidence.json",
    "required_stages": [
      "red",
      "green"
    ],
    "allowed_exceptions": [
      "docs_only",
      "mechanical_no_behavior_change",
      "no_runnable_harness",
      "external_constraint"
    ],
    "exception_requires": [
      "reason",
      "alternative_verification"
    ]
  },
  "continuous_learning": {
    "enabled": true,
    "state_root": "/Users/mikhail/.agents/state/learning",
    "state_db": "/Users/mikhail/.agents/state/learning/state.db",
    "memory_root": "/Users/mikhail/.agents/state/memory",
    "project_scoped": true,
    "global_preferences": true,
    "auto_globalize_explicit_preferences": true,
    "session_search": "sqlite_fts5_with_like_fallback",
    "context_injection": "fenced_memory_context_not_user_input",
    "memory_tiers": [
      "working",
      "episodic",
      "semantic",
      "procedural"
    ],
    "redact_secrets": true,
    "max_observation_bytes": 5000,
    "durable_wiki": {
      "enabled": true,
      "root": "~/Documents/llm-wiki",
      "agent_symlink": "~/.agents/state/memory/llm-wiki",
      "helper": "~/.agents/scripts/agent_wiki.py",
      "use_when": [
        "personal_or_project_memory",
        "codex_memory",
        "obsidian_memory",
        "durable_context",
        "cross_session_synthesis",
        "agent_session_history"
      ],
      "read_first": [
        "AGENTS.md",
        "index.md"
      ],
      "immutable_paths": [
        "raw/"
      ],
      "audit_log": "log.md",
      "context_injection": "fenced_memory_context_not_user_input"
    }
  },
  "validators": {
    "schema_validation": true,
    "skill_non_empty": true,
    "docs_frontmatter": true,
    "subagent_frontmatter": true,
    "no_personal_paths": true,
    "sync_manifest": true,
    "hook_manifest": true,
    "skill_catalog": true,
    "shared_references": true,
    "supply_chain_recipes": true
  },
  "supply_chain_hardening": {
    "dependency_updates": "explicit_user_request_only",
    "prefer_local_pinned_binaries": true,
    "forbid_runtime_executors": [
      "npx",
      "pnpm dlx",
      "bunx",
      "uvx",
      "curl | sh",
      "@latest"
    ],
    "forbid_release_check_commands": [
      "npm outdated",
      "pnpm outdated",
      "bun outdated",
      "npm-check-updates",
      "npm view"
    ],
    "safe_install_commands": {
      "bun": "bun install --frozen-lockfile --minimum-release-age 604800",
      "pnpm": "pnpm install --frozen-lockfile --ignore-scripts",
      "yarn": "yarn install --frozen-lockfile --ignore-scripts",
      "npm": "npm ci --ignore-scripts"
    }
  },
  "delegation": {
    "default_layer": "native_subagents",
    "delegate_by": "task_intent",
    "delegate_by_not": "skill_name",
    "max_implementation_specialists": 1,
    "single_writer_per_cwd_or_worktree": true,
    "parallel_subagents": "read_only_or_isolated_worktrees_only",
    "optional_auditor": true,
    "advisory_review_subagents_ok": true,
    "one_subagent_per_skill": false,
    "capability_clusters_only": true,
    "main_agent_may_invoke_native_subagents_without_user_prompt": true,
    "ai_bridge_explicit_only": true,
    "ai_bridge_requires_named_target": true,
    "ai_bridge_auto_routing": "explicit_user_request_only"
  },
  "subagent_routing": {
    "default": "native_subagents_first",
    "main_agent_final_synthesis": true,
    "final_accept_reject_owner": "main_agent_or_host_orchestrator",
    "multi_agent_decision": {
      "prefer_single_when": [
        "ordered_dependency_chain",
        "shared_mutable_workspace_without_isolation",
        "tiny_single_step_task",
        "same_instructions_tools_and_policy"
      ],
      "split_when": [
        "different_instructions_tools_policy_or_evaluation_criteria",
        "independent_read_only_exploration",
        "fresh_advisory_review",
        "context_isolation_materially_helps"
      ]
    },
    "route_by_task_intent": {
      "codebase_mapping": "cartographer",
      "code_review": "code-reviewer",
      "build_error_resolution": "build-error-resolver",
      "typescript_review": "typescript-reviewer",
      "swift_review": "swift-reviewer",
      "database_review": "database-reviewer",
      "e2e_testing": "e2e-runner",
      "browser_research": "browser-researcher",
      "backend": "backend-architect",
      "frontend": "frontend-engineer",
      "greenfield_ui": "design-engineer",
      "redesign": "design-engineer",
      "ui_audit": "ui-auditor",
      "security_review": "security-auditor",
      "compliance_or_seo": "compliance-seo-auditor",
      "mobile": "mobile-engineer",
      "thermo_review": "thermo-nuclear-review-subagent",
      "thermo_code_quality": "thermo-nuclear-code-quality-review-subagent"
    },
    "when_to_use": [
      "specialist_focus",
      "parallel_independent_work",
      "fresh_review",
      "context_isolation",
      "large_read_only_exploration",
      "verification_after_implementation"
    ],
    "when_not_to_use": [
      "tiny_single_step_tasks",
      "tightly_coupled_edits_that_would_conflict",
      "parallel_writers_on_same_cwd_or_worktree",
      "final_accept_reject_not_delegated"
    ],
    "thermos": {
      "agents": [
        "thermo-nuclear-review-subagent",
        "thermo-nuclear-code-quality-review-subagent"
      ],
      "mode": "parallel_then_synthesize",
      "scope": "diff_only",
      "default_base": "main"
    }
  },
  "ai_bridge": {
    "role": "backup_cross_tool_escape_hatch",
    "entrypoints": [
      "ai-delegate",
      "ai-dispatch"
    ],
    "use_only_when_user_explicitly_requests_bridge": true,
    "requires_named_target": true,
    "allowed_targets": [
      "codex",
      "cursor",
      "opencode",
      "claude",
      "goose",
      "gemini",
      "aider",
      "amp",
      "cline",
      "droid"
    ],
    "auto_target_allowed": "only_when_user_explicitly_requests_auto_bridge_routing",
    "native_subagents_first": true,
    "if_target_missing": "ask_user_which_coding_tool_to_open"
  },
  "skill_loading_disclosure": {
    "canonical_skills_root": "/Users/mikhail/.agents/skills",
    "read_before_substantive_work": "Read SKILL.md for every skill in the active stack: default_stack, task_mapping additions, skill_triggers, and for subagents every SKILL.md path listed in that subagent file.",
    "disclosure": {
      "when": "first_substantive_message_in_thread_or_start_of_subagent_run",
      "format": "list_skill_directory_names_only",
      "must_include": "every_skill_whose_SKILL_md_was_read_for_this_turn_or_run"
    },
    "on_missing_skill_file": "name_the_path_then_fallback_to_AGENTS_md_and_this_policy",
    "subagents": {
      "must_read": "all_canonical_SKILL_md_paths_listed_in_that_subagent_before_substantive_output",
      "must_disclose": "same_disclosure_rules_as_main_agent"
    }
  },
  "output_economy": {
    "default": "professional_concise",
    "style": "normal_grammar_no_gimmick_voice",
    "goal": "spend_output_tokens_on_code_decisions_risks_verification_and_useful_handoff_context",
    "spend_tokens_on": [
      "code",
      "commands",
      "decisions",
      "risks",
      "verification",
      "useful_context",
      "handoff_context"
    ],
    "avoid": [
      "filler",
      "praise",
      "long_progress_narration",
      "repeated_tool_output_without_synthesis",
      "raw_output_dumps_unless_requested",
      "forced_persona",
      "caveman_talk",
      "gimmick_voice",
      "generic_closing_offers"
    ],
    "preserve_precision_for": [
      "code",
      "commands",
      "file_paths",
      "errors",
      "api_names",
      "test_results",
      "public_interfaces"
    ],
    "progress_updates": {
      "default": "only_when_useful_or_work_is_long_running",
      "max_sentences": 2,
      "must_include": [
        "new_information",
        "why_it_matters"
      ]
    },
    "final_responses": {
      "default": "concise",
      "prefer": [
        "changed_surfaces",
        "behavioral_effect",
        "tests_or_checks_run",
        "known_blockers_or_residual_risk"
      ],
      "max_lines_guidance": "prefer_under_25_lines_for_routine_tasks_under_70_lines_for_complex_tasks"
    },
    "subagents": {
      "inherit": true,
      "final_output": "findings_changes_decisions_and_verification_only_no_process_narration"
    }
  },
  "context_economy": {
    "default": "precompact_unknown_large_context",
    "command_output_protection": {
      "unknown_or_potentially_large_output": "must_byte_cap_or_write_to_temp_then_inspect_ranges",
      "default_byte_cap": 6000,
      "preferred_patterns": [
        "COMMAND 2>&1 | head -c 6000",
        "COMMAND > /tmp/agent-output.txt 2>&1 then inspect bounded ranges",
        "grep -n PATTERN file | head -n 40",
        "git status --porcelain | head -n 50",
        "git diff --name-only | head -n 80"
      ]
    },
    "raw_data_policy": {
      "default": "do_not_read_raw_large_data_directly",
      "precompact_first_with": [
        "python3 ~/.agents/scripts/context_needle.py repo-map .",
        "python3 ~/.agents/scripts/context_needle.py file-summary PATH",
        "python3 ~/.agents/scripts/context_needle.py json-summary PATH",
        "python3 ~/.agents/scripts/context_needle.py csv-summary PATH",
        "python3 ~/.agents/scripts/context_needle.py log-filter PATH --pattern PATTERN --limit 40"
      ],
      "feed_agent_target": "prefer_200_to_500_tokens_of_distilled_findings_before_opening_large_sources"
    },
    "scope_walls": [
      "skip_vendor_build_cache_generated_and_archive_dirs_by_default",
      "summarize_before_opening_new_large_or_unknown_files",
      "never_paste_full_source_unless_explicitly_requested",
      "inspect_only_files_needed_for_the_exact_task"
    ],
    "handoff": {
      "preferred_files": [
        "HANDOFF.md",
        "docs/CODEBASE_MAP.md",
        "docs/DESIGN_CONCEPT.md"
      ],
      "target_size_tokens": 1000,
      "keep": [
        "current_goal",
        "success_metrics",
        "key_files",
        "recent_decisions",
        "commands_run",
        "known_issues",
        "do_not_reread",
        "next_steps"
      ],
      "remove": [
        "dead_ends",
        "repetition",
        "large_logs",
        "raw_data"
      ]
    },
    "compact_cadence": "at_phase_boundaries_or_every_4_to_5_substantive_turns_when_context_is_growing"
  },
