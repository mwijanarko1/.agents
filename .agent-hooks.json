{
  "$schema": "file:///Users/mikhail/.agents/hooks/schema/agent-hooks.schema.json",
  "version": 1,
  "tasks": {
    "format": {
      "runner": "command",
      "argv": ["python3", "-m", "unittest", "discover", "-s", "/Users/mikhail/.agents/tests"]
    },
    "lint": {
      "runner": "command",
      "argv": ["python3", "/Users/mikhail/.agents/scripts/validate_agent_policy.py", "--all"]
    },
    "test": {
      "runner": "command",
      "argv": ["python3", "-m", "unittest", "discover", "-s", "/Users/mikhail/.agents/tests"]
    },
    "doctor": {
      "runner": "command",
      "argv": ["python3", "/Users/mikhail/.agents/scripts/agent_doctor.py"]
    }
  },
  "protect": {
    "files": [".env*", "secrets/**"],
    "commands": ["git push --force", "rm -rf /"]
  },
  "prGate": {
    "enabled": true
  },
  "docs": {
    "paths": ["docs/**", "skills/**", "hooks/**", "schemas/**", "manifests/**"]
  },
  "schema": {
    "paths": ["schemas/**", "hooks/schema/**", "manifests/**"]
  },
  "tdd": {
    "enabled": true,
    "testCommand": ["python3", "-m", "unittest", "discover", "-s", "/Users/mikhail/.agents/tests"],
    "productionPaths": ["scripts/**", "hooks/**", "skills/**"],
    "testPaths": ["tests/**"]
  },
  "learning": {
    "enabled": true,
    "projectScoped": true
  },
  "qualityGate": {
    "enabled": true,
    "strict": false
  },
  "web": {
    "enabled": false
  }
}
