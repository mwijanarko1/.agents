{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mikhailspeaks.dev/schemas/sync-manifest.schema.json",
  "title": "Sync Manifest",
  "type": "object",
  "required": [
    "version",
    "mappings"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "targets"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "type"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "symlink",
                    "copy"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "optional": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
