{
  "version": 1,
  "tools": [
    {
      "name": "codex",
      "config": "~/.codex/hooks.json",
      "required_hooks": [
        {
          "event": "PreToolUse",
          "command_contains": "codex-preflight.sh"
        },
        {
          "event": "PostToolUse",
          "command_contains": "tdd-record.sh"
        },
        {
          "event": "UserPromptSubmit",
          "command_contains": "ai-flow-gate.sh"
        },
        {
          "event": "Stop",
          "command_contains": "validator-gate.sh"
        },
        {
          "event": "Stop",
          "command_contains": "tdd-gate.sh"
        },
        {
          "event": "Stop",
          "command_contains": "codex-stop.sh"
        }
      ]
    },
    {
      "name": "cursor",
      "config": "~/.cursor/hooks.json",
      "required_hooks": [
        {
          "event": "beforeShellExecution",
          "command_contains": "cursor-before-shell.sh"
        },
        {
          "event": "afterShellExecution",
          "command_contains": "tdd-record.sh"
        },
        {
          "event": "UserPromptSubmit",
          "command_contains": "ai-flow-gate.sh"
        },
        {
          "event": "stop",
          "command_contains": "validator-gate.sh"
        },
        {
          "event": "stop",
          "command_contains": "tdd-gate.sh"
        }
      ]
    }
  ]
}
